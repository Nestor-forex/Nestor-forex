# Copia este archivo a ".env.local" (que nunca se sube al repositorio) para
# probar Firebase en tu computador con `npm run dev`.
#
# Los valores exactos salen de: Firebase Console → ⚙️ Configuración del
# proyecto → General → "Tus apps" → app web → "Configuración del SDK".
#
# La app publicada (GitHub Pages) usa los valores reales ya guardados en
# ".env.production" (sí se sube al repositorio: son de un app web de
# Firebase, no son secretos — ver el comentario en ese archivo).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Correo que tendrá permisos de administrador (aprobar/retirar miembros).
VITE_ADMIN_EMAIL=nesdian2204@gmail.com

# Puente de MetaTrader 5 (servidor de Python con FastAPI que corre junto a MT5
# y expone GET /quotes con el bid y el ask de cada par).
#
# En desarrollo apunta al propio computador. Para que la app publicada pueda
# usarlo, el puente tiene que estar accesible desde internet por HTTPS y esta
# variable tiene que apuntar a esa dirección — 127.0.0.1 solo funciona en la
# misma máquina donde corre el puente.
VITE_API_URL=http://127.0.0.1:8000
