# Configuración real de Firebase para la app publicada.
#
# Estos valores NO son secretos: Firebase los documenta como seguros para
# incluir en el código de una app web (a diferencia de una clave de API de
# servidor). La seguridad de verdad la dan las reglas de Firestore
# (firestore.rules) y Firebase Auth, no ocultar este archivo.
# https://firebase.google.com/docs/projects/api-keys

VITE_FIREBASE_API_KEY=AIzaSyBbIOnRPd8mmmBsmitm1orl6WXsdZfPgE8
VITE_FIREBASE_AUTH_DOMAIN=nestor-forex.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nestor-forex
VITE_FIREBASE_STORAGE_BUCKET=nestor-forex.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=680680525180
VITE_FIREBASE_APP_ID=1:680680525180:web:aace65c12e7497fa7628f9

VITE_ADMIN_EMAIL=nesdian2204@gmail.com

# ⚠️ LA LLAVE DE TWELVE DATA YA NO VA AQUÍ (se sacó el 2026-09-03).
#
# Vive en el secreto `TWELVEDATA_KEY` del repositorio, que solo ven los
# workflows de GitHub Actions. Aquí estaba a la vista de cualquiera que mirara
# el repositorio, y encima es la MISMA llave que usa la app hermana de
# intradía: comparten cuenta y los 800 créditos del día, así que quien gastara
# la cuota dejaría sin precios a las dos apps.
#
# Si algún día hace falta cambiarla, se cambia en los DOS repositorios:
# Settings → Secrets and variables → Actions.

# Puente de MetaTrader 5. Hoy apunta al computador local, así que en la app
# publicada la tarjeta de precios en vivo mostrará "no se pudo conectar" para
# todo el mundo salvo en la máquina donde corren MT5 y el puente. Cuando el
# puente tenga una dirección pública con HTTPS, se cambia aquí y se vuelve a
# publicar: no hay que tocar ni una línea de código.
VITE_API_URL=http://127.0.0.1:8000
